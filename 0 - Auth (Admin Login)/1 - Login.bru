meta {
  name: 1 - Login
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/sign-in/email
  body: json
  auth: none
}

body:json {
  {
    "email": "gilbert.tiofandy24@gmail.com",
    "password": "asdf1234"
  }
}

script:post-response {
  const sessionToken = res.getHeader("set-auth-token");
  if (sessionToken) {
    bru.setVar("sessionToken", sessionToken);
  }
}

docs {
  better-auth (bearer plugin) balikin session token lewat header
  "set-auth-token", bukan lewat body. Script di atas otomatis nyimpen ke
  var {{sessionToken}} buat dipakai request "2 - Get JWT".
}
