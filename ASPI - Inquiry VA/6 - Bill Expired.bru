docs {
  Order OEMJI-260907065401-M3BR98UN. Jalankan SQL ini dulu di production
  sebelum request ini, biar VA-nya dianggap expired:

  update payments
  set payment_response = jsonb_set(payment_response, '{expiry_time}', '"2020-01-01 00:00:00"')
  where transaction_id = 'OEMJI-260907065401-M3BR98UN';
}

