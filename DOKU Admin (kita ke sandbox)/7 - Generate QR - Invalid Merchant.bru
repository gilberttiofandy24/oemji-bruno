meta {
  name: 7 - Generate QR - Invalid Merchant
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/doku/qris
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "partnerReferenceNo": "TESTQR-0003",
    "amount": {
      "value": "10000.00",
      "currency": "IDR"
    },
    "merchantId": "00000000",
    "validityPeriod": "2026-12-31T23:59:59+07:00",
    "additionalInfo": {
      "postalCode": "12345",
      "feeType": 1
    }
  }
}

docs {
  merchantId sengaja diisi angka ngasal (bukan cfg.Doku.QrisMerchantId asli)
  buat trigger Invalid Merchant.
}
