meta {
  name: 8 - Decode QR
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/doku/qris/decode
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "partnerReferenceNo": "TESTQR-DECODE-0002",
    "qrContent": "asal-bukan-qr-valid",
    "scanTime": "2026-09-07T16:30:00+07:00"
  }
}

docs {
  qrContent diambil dari response "5 - Generate QR MPM" (field qrContent,
  bukan gambar/base64 -- itu string EMV QR mentah).
}
